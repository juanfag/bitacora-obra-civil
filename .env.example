DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bitacora_obra"
JWT_SECRET="change-me"

NODE_ENV="development"
LOG_LEVEL="debug"
LOG_PRETTY="false"

UPLOAD_PATH="uploads"
UPLOAD_PUBLIC_PATH="/uploads"
UPLOAD_MAX_FILE_SIZE_BYTES="5242880"
UPLOAD_ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp,application/pdf"
